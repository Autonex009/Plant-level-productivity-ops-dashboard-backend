DATABASE_URL=postgresql+psycopg2://plantops:plantops@localhost:5432/plant_ops_dashboard

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-side only - powers the dashboard's chat assistant. Get one at
# https://platform.deepseek.com/api_keys. Leave unset to disable chat (the
# widget stays visible but shows a "not configured" message).
DEEPSEEK_API_KEY=
